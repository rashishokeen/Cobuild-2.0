# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Email (Nodemailer) ─────────────────────────────────
# Set MAIL_ENABLED=true to actually send emails.
# Leave false during development — submissions still save to the DB.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=team.cobuildd@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM="CoBuild Team <team.cobuildd@gmail.com>"
MAIL_TO=team.cobuildd@gmail.com

# ── Database ───────────────────────────────────────────
# Path to the SQLite database file (relative to project root)
DB_PATH=./server/db/cobuild.db

# ── Rate limiting ──────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
